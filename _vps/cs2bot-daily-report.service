[Unit]
Description=CS2 bot daily report (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bot
Group=bot
WorkingDirectory=/home/bot/esports
ExecStart=/home/bot/esports/venv/bin/python /home/bot/esports/daily_report.py
StandardOutput=append:/home/bot/esports/_logs/daily_report.log
StandardError=append:/home/bot/esports/_logs/daily_report.log
