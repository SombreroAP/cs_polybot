# Polymarket Credentials
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
POLYMARKET_FUNDER_ADDRESS=0xYOUR_FUNDER_ADDRESS_HERE
POLYMARKET_SIGNATURE_TYPE=1

# Trading Parameters
MIN_BET=2.0
MAX_BET=50.0
BASE_BET=10.0
MIN_CONFIDENCE=0.65
MAX_OPEN_POSITIONS=3

# Latency Thresholds
MIN_LATENCY_EDGE_SECONDS=2.0
MAX_ODDS_STALENESS_SECONDS=30.0

# ─── CS2 Settings ────────────────────────────────────────────────
CS2_ONLY_MODE=true
CS2_CT_WIN_RATE=0.53
CS2_PISTOL_WIN_RATE=0.50
CS2_ECO_THRESHOLD=10000
CS2_FORCE_THRESHOLD=20000
CS2_DISCOVERY_INTERVAL=60

# Game Feeds (only used if CS2_ONLY_MODE=false)
ENABLED_GAMES=cs2,lol,dota2,valorant

# Dashboard
DASHBOARD_PORT=8082

# Logging
LOG_LEVEL=INFO
